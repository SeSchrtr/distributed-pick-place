<?xml version="1.0"?>
<package format="3">
  <name>panda_demo_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic world and launch files for the distributed Panda demo.</description>
  <maintainer email="sebastian.schroeter@mailbox.org">Sebastian Schroeter</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>
  <exec_depend>panda_demo_description</exec_depend>
  <exec_depend>panda_grasp_adapter</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
